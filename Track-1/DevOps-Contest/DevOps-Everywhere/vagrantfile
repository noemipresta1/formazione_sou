Vagrant.configure("2") do |config|
 # Scelta del sistema operativo 
config.vm.box = "debian/bookworm64"

# Collega la porta 80 di Apache alla porta 8080 del Mac
config.vm.network "forwarded_port", guest: 80, host: 8080, host_ip: "0.0.0.0" 

# Crea la cartella ./libri sul computer locale (per chiunque)
Dir.mkdir("./libri") unless Dir.exist?("./libri")

# Collega la cartella libri (del Mac) alla cartella /var/www/html della VM 
config.vm.synced_folder "./libri", "/var/www/html"

# Assegna nome alla VM.
config.vm.provider "virtualbox" do |vb|
vb.name = "debian-prog-vagrant"
vb.memory = "1024"
vb.cpus = 1

  end

# Di a Vagrant di eseguire questi comandi dentro la VM appena viene accesa (la prima volta)
config.vm.provision "shell", inline: <<-SHELL
apt-get update
apt-get install -y apache2

# Abilita all'avvio
systemctl enable apache2 

# Riavvia subito
systemctl restart apache2 
  
  SHELL
end
